# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Finnhub -----------------------------------------------------------------
FINNHUB_API_KEY=your_finnhub_api_key_here
STOCK_SYMBOLS=AAPL,MSFT,TSLA,GOOGL,AMZN
LOG_LEVEL=INFO

# --- Kafka -------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=stock.trades.v1

# --- Snowflake ---------------------------------------------------------------
# Snowpipe Streaming requires key-pair auth. Generate with:
#   ./scripts/generate_snowflake_keypair.sh
SNOWFLAKE_ACCOUNT=xy12345.eu-west-1
SNOWFLAKE_USER=STOCKS_STREAMING_SVC
SNOWFLAKE_PRIVATE_KEY=paste_the_pkcs8_body_here_as_one_line
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=STOCKS_TRANSFORMER
SNOWFLAKE_DATABASE=STOCKS_MDS
SNOWFLAKE_WAREHOUSE=STOCKS_WH
DBT_TARGET=dev
DBT_SCHEMA=DEV

# --- MinIO (archive / replay zone) -------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minimum_8_chars
MINIO_BUCKET=stock-trades-archive

# --- Airflow -----------------------------------------------------------------
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=generate_me
# Generate with: openssl rand -hex 32
AIRFLOW_WEBSERVER_SECRET_KEY=generate_me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_EMAIL=admin@example.com
POSTGRES_PASSWORD=change_me
